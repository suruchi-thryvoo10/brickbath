{
  "name": "brick-n-bath",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "node ./node_modules/next/dist/bin/next dev -p 3100",
