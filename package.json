    "lint:win": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck:win": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2"
  }
}
